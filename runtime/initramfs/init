#!/rescue/bin/busybox sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022
BB=/rescue/bin/busybox
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /dev/pts /tmp /run
$BB mount -t devpts devpts /dev/pts
$BB mount -t tmpfs -o mode=1777 tmpfs /tmp
$BB mkdir -p /tmp/run /tmp/lock /tmp/log /tmp/state /tmp/.uci /tmp/resolv.conf.d /tmp/sysinfo
$BB chmod 0700 /tmp/.uci
exec </dev/console >/dev/kmsg 2>&1
echo BE7000-OpenWrt >/proc/sys/kernel/hostname
echo 0 >/proc/sys/kernel/kptr_restrict
echo 0 >/proc/sys/kernel/panic
echo xiaomi,be7000 >/tmp/sysinfo/board_name
echo 'Xiaomi BE7000' >/tmp/sysinfo/model
echo 'BE7000: starting USB OpenWrt'
for path in dev proc sys tmp; do
    $BB mount --bind /$path /rescue/$path || exit 1
done
$BB insmod /lib/modules/5.4.164/leds-gpio.ko
if $BB sh /rescue/bin/usb-logs.sh >/tmp/usb-logs-start.log 2>&1 &&
   $BB sh /rescue/bin/early-network.sh >/tmp/early-network.log 2>&1 &&
   $BB sh /rescue/bin/usb-root.sh >/tmp/usb-root.log 2>&1; then
    exec $BB chroot /mnt/owrt-root /sbin/procd -d 2
fi
echo 'BE7000: startup failed; see USB logs. Reboot to return to stock.'
while :; do $BB sleep 10; done
