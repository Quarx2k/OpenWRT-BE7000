Pass the requested MAC when creating AP and other data interfaces.
cfg80211 forwards it only to drivers advertising MAC_ON_CREATE; retain
the existing netdev address assignment for drivers without that feature.

--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -6308,7 +6308,7 @@ static int nl80211_create_iface_once(struc
 	if (nla_put_flag(msg, NL80211_ATTR_IFACE_SOCKET_OWNER))
 		goto fail;
 
-	if ((addr && iftype == NL80211_IFTYPE_P2P_DEVICE) &&
+	if (addr && iftype != NL80211_IFTYPE_MONITOR &&
 	    nla_put(msg, NL80211_ATTR_MAC, ETH_ALEN, addr))
 		goto fail;
 
