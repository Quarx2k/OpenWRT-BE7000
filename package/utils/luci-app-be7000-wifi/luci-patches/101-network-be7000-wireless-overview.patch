 'require uqr';
 
 const isReadonlyView = !L.hasViewPermission();
+let wifiOverview = {};
+const callWifiOverview = rpc.declare({
+	object: 'be7000.wifi',
+	method: 'overview',
+	expect: { '': {} }
+});
+
+function radio_mlo(radioDev) {
+	return wifiOverview.mlo?.devices[0] == radioDev.getName() ? wifiOverview.mlo : null;
+}
 
