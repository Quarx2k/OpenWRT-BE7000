 }
 
+static int ath12k_qmi_assign_pci_fixed_mem_chunk(struct ath12k_base *ab,
+						 int idx, int i, const char *name)
+{
+	struct reserved_mem *rmem;
+	int region;
+
+	region = of_property_match_string(ab->dev->of_node, "memory-region-names", name);
+	if (region < 0)
+		return region;
+
+	rmem = ath12k_core_get_reserved_mem(ab, region);
+	if (!rmem)
+		return -ENODEV;
+
+	if (rmem->size < ab->qmi.target_mem[i].size) {
+		ath12k_err(ab, "reserved %s memory too small for %u bytes\n",
+			   name, ab->qmi.target_mem[i].size);
+		return -EINVAL;
+	}
+
+	ab->qmi.target_mem[idx].paddr = rmem->base;
+	ab->qmi.target_mem[idx].v.ioaddr =
+		ioremap(ab->qmi.target_mem[idx].paddr,
+			ab->qmi.target_mem[i].size);
+	if (!ab->qmi.target_mem[idx].v.ioaddr)
+		return -EIO;
+
+	return 0;
+}
+
 static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 {
 	struct reserved_mem *rmem;
@@ -2732,6 +2800,38 @@ static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 	int i, idx, ret;
 
 	for (i = 0, idx = 0; i < ab->qmi.mem_seg_count; i++) {
+		if (ab->hif.bus == ATH12K_BUS_PCI) {
+			switch (ab->qmi.target_mem[i].type) {
+			case HOST_DDR_REGION_TYPE:
+				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i, "qmi");
+				break;
+			case M3_DUMP_REGION_TYPE:
+				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
+									    "m3-dump");
+				break;
+			case CALDB_MEM_REGION_TYPE:
+				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
+									    "caldb");
+				break;
+			case PAGEABLE_MEM_REGION_TYPE:
+				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
+									    "pageable");
+				break;
+			default:
+				ath12k_dbg(ab, ATH12K_DBG_QMI,
+					   "qmi ignore unsupported mem req type %u size %u index %d\n",
+					   ab->qmi.target_mem[i].type,
+					   ab->qmi.target_mem[i].size, i);
+				continue;
+			}
+			if (ret)
+				goto out;
+			ab->qmi.target_mem[idx].size = ab->qmi.target_mem[i].size;
+			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
+			idx++;
+			continue;
+		}
+
 		switch (ab->qmi.target_mem[i].type) {
 		case HOST_DDR_REGION_TYPE:
 			rmem = ath12k_core_get_reserved_mem(ab, 0);
@@ -2900,6 +3000,9 @@ int ath12k_qmi_request_target_cap(struct ath12k_base *ab)
 	else
 		ab->qmi.target.board_id = board_id;
 
+	ath12k_qmi_apply_dt_board_id(ab);
+	ath12k_qmi_apply_dt_num_radios(ab);
+
 	if (resp.soc_info_valid)
 		ab->qmi.target.soc_id = resp.soc_info.soc_id;
 
