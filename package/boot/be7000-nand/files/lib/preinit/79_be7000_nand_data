be7000_nand_data() {
	local dir marker=0 data=0
	. /lib/be7000-nand.sh
	be7000_nand_guard || return 1
	[ -f /sys/class/ubi/ubi1/mtd_num ] || ubiattach -m 28 -d 1 || :
	for dir in /sys/class/ubi/ubi1_*; do
		[ -f "$dir/name" ] || continue
		[ "$(cat "$dir/name")" != be7000-nand-v1 ] || marker=1
		[ "$(cat "$dir/name")" != rootfs_data ] || data=1
	done
	if [ "$marker" = 0 ]; then
		[ ! -f /sys/class/ubi/ubi1/mtd_num ] || ubidetach -m 28 || return 1
		ubiformat /dev/mtd28 -y || return 1
		ubiattach -m 28 -d 1 || return 1
		ubimkvol /dev/ubi1 -N be7000-nand-v1 -s 126976 || return 1
		data=0
	fi
	[ "$data" = 1 ] || ubimkvol /dev/ubi1 -N rootfs_data -m
}

boot_hook_add preinit_main be7000_nand_data
