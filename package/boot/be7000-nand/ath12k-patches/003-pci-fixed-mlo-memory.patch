Subject: wifi: ath12k: assign fixed PCI MLO memory

diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index e0522081db..80ff522e58 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2525,6 +2525,7 @@ out:
 void ath12k_qmi_reset_mlo_mem(struct ath12k_hw_group *ag)
 {
 	struct target_mem_chunk *mlo_chunk;
+	bool fixed_mem;
 	int i;
 
 	lockdep_assert_held(&ag->mutex);
@@ -2532,10 +2533,13 @@ void ath12k_qmi_reset_mlo_mem(struct ath12k_hw_group *ag)
 	if (!ag->mlo_mem.init_done || ag->num_started)
 		return;
 
+	fixed_mem = test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ag->ab[0]->dev_flags);
 	for (i = 0; i < ARRAY_SIZE(ag->mlo_mem.chunk); i++) {
 		mlo_chunk = &ag->mlo_mem.chunk[i];
 
-		if (mlo_chunk->v.addr)
+		if (fixed_mem && mlo_chunk->v.ioaddr)
+			memset_io(mlo_chunk->v.ioaddr, 0, mlo_chunk->size);
+		else if (mlo_chunk->v.addr)
 			/* TODO: Mode 0 recovery is the default mode hence resetting the
 			 * whole memory region for now. Once Mode 1 support is added, this
 			 * needs to be handled properly
@@ -2793,11 +2797,71 @@ static int ath12k_qmi_assign_pci_fixed_mem_chunk(struct ath12k_base *ab,
 	return 0;
 }
 
+static int ath12k_qmi_assign_pci_mlo_mem_chunk(struct ath12k_base *ab,
+					    int idx, int i, int mlo_idx)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct target_mem_chunk *chunk = &ab->qmi.target_mem[i];
+	struct target_mem_chunk *mlo_chunk;
+	struct reserved_mem *rmem;
+	size_t offset = 0;
+	int region, j;
+
+	lockdep_assert_held(&ag->mutex);
+	if (mlo_idx >= ARRAY_SIZE(ag->mlo_mem.chunk))
+		return -EINVAL;
+
+	region = of_property_match_string(ab->dev->of_node, "memory-region-names",
+					"mlo-global");
+	if (region < 0)
+		return region;
+	rmem = ath12k_core_get_reserved_mem(ab, region);
+	if (!rmem)
+		return -ENODEV;
+
+	for (j = 0; j < mlo_idx; j++)
+		offset += ag->mlo_mem.chunk[j].size;
+	if (offset > rmem->size || chunk->size > rmem->size - offset) {
+		ath12k_err(ab, "reserved MLO memory too small for %u bytes at %zu\n",
+			   chunk->size, offset);
+		return -EINVAL;
+	}
+
+	mlo_chunk = &ag->mlo_mem.chunk[mlo_idx];
+	if (mlo_chunk->paddr) {
+		if (mlo_chunk->size != chunk->size ||
+		    mlo_chunk->paddr != rmem->base + offset)
+			return -EINVAL;
+	} else {
+		mlo_chunk->v.ioaddr = ioremap(rmem->base + offset, chunk->size);
+		if (!mlo_chunk->v.ioaddr)
+			return -EIO;
+		mlo_chunk->paddr = rmem->base + offset;
+		mlo_chunk->size = chunk->size;
+		mlo_chunk->type = chunk->type;
+		memset_io(mlo_chunk->v.ioaddr, 0, mlo_chunk->size);
+	}
+
+	ab->qmi.target_mem[idx].paddr = mlo_chunk->paddr;
+	ab->qmi.target_mem[idx].v.ioaddr = mlo_chunk->v.ioaddr;
+	return 0;
+}
+
 static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 {
+	struct ath12k_hw_group *ag = ab->ag;
 	struct reserved_mem *rmem;
 	size_t avail_rmem_size;
-	int i, idx, ret;
+	bool pci = ab->hif.bus == ATH12K_BUS_PCI;
+	int i, idx, ret, mlo_idx = 0, mlo_size = 0;
+
+	if (pci) {
+		mutex_lock(&ag->mutex);
+		if (!ag->mlo_mem.init_done) {
+			memset(ag->mlo_mem.chunk, 0, sizeof(ag->mlo_mem.chunk));
+			ag->mlo_mem.init_done = true;
+		}
+	}
 
 	for (i = 0, idx = 0; i < ab->qmi.mem_seg_count; i++) {
 		if (ab->hif.bus == ATH12K_BUS_PCI) {
@@ -2817,6 +2881,11 @@ static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
 									    "pageable");
 				break;
+			case MLO_GLOBAL_MEM_REGION_TYPE:
+				ret = ath12k_qmi_assign_pci_mlo_mem_chunk(ab, idx, i,
+								       mlo_idx++);
+				mlo_size += ab->qmi.target_mem[i].size;
+				break;
 			default:
 				ath12k_dbg(ab, ATH12K_DBG_QMI,
 					   "qmi ignore unsupported mem req type %u size %u index %d\n",
@@ -2941,11 +3010,22 @@ static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 			break;
 		}
 	}
+	if (pci && ag->mlo_mem.mlo_mem_size &&
+	    ag->mlo_mem.mlo_mem_size != mlo_size) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (pci) {
+		ag->mlo_mem.mlo_mem_size = mlo_size;
+		mutex_unlock(&ag->mutex);
+	}
 	ab->qmi.mem_seg_count = idx;
 
 	return 0;
 out:
 	ath12k_qmi_free_target_mem_chunk(ab);
+	if (pci)
+		mutex_unlock(&ag->mutex);
 	return ret;
 }
 
