--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/be7000.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include "core.h"
+#include "be7000.h"
+
+static int be7000_dual = -1;
+module_param(be7000_dual, int, 0444);
+MODULE_PARM_DESC(be7000_dual, "BE7000 NAND: 0 for single, 1 for dual 5 GHz");
+
+static bool ath12k_be7000_selectable(struct ath12k_base *ab)
+{
+	return of_property_read_bool(ab->dev->of_node, "xiaomi,selectable-radio-mode");
+}
+
+int ath12k_get_board_id(struct ath12k_base *ab, u32 *board_id)
+{
+	if (ath12k_be7000_selectable(ab)) {
+		*board_id = be7000_dual == 1 ? 0x1008 : 0x2;
+		return 0;
+	}
+	if (!of_property_read_u32(ab->dev->of_node, "qcom,board_id", board_id))
+		return 0;
+	return of_property_read_u32(ab->dev->of_node, "qcom,board-id", board_id);
+}
+
+int ath12k_get_num_radios(struct ath12k_base *ab, u32 *num_radios)
+{
+	if (ath12k_be7000_selectable(ab)) {
+		*num_radios = be7000_dual == 1 ? 2 : 1;
+		return 0;
+	}
+	return of_property_read_u32(ab->dev->of_node, "qcom,num-radios", num_radios);
+}
+
+int ath12k_be7000_init(struct ath12k_base *ab)
+{
+	struct gpio_desc *low, *high;
+
+	if (!ath12k_be7000_selectable(ab))
+		return 0;
+	if (be7000_dual != 0 && be7000_dual != 1)
+		return dev_err_probe(ab->dev, -EINVAL, "BE7000 radio mode was not prepared\n");
+
+	low = devm_gpiod_get(ab->dev, "rf-low",
+			     be7000_dual ? GPIOD_OUT_HIGH : GPIOD_OUT_LOW);
+	if (IS_ERR(low))
+		return dev_err_probe(ab->dev, PTR_ERR(low), "Cannot select RF low path\n");
+	high = devm_gpiod_get(ab->dev, "rf-high",
+			      be7000_dual ? GPIOD_OUT_LOW : GPIOD_OUT_HIGH);
+	if (IS_ERR(high))
+		return dev_err_probe(ab->dev, PTR_ERR(high), "Cannot select RF high path\n");
+	return 0;
+}
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/be7000.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef ATH12K_BE7000_H
+#define ATH12K_BE7000_H
+
+int ath12k_be7000_init(struct ath12k_base *ab);
+int ath12k_get_board_id(struct ath12k_base *ab, u32 *board_id);
+int ath12k_get_num_radios(struct ath12k_base *ab, u32 *num_radios);
+
+#endif
