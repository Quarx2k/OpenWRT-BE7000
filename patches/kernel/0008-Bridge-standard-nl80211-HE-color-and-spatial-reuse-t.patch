 	[NL80211_ATTR_SAE_PWE] = NLA_POLICY_RANGE(NLA_U8, NL80211_SAE_PWE_HUNT_AND_PECK,
 						  NL80211_SAE_PWE_BOTH),
@@ -4738,6 +4750,8 @@ static int nl80211_start_ap(struct sk_buff *skb, struct genl_info *info)
