Subject: [PATCH] clk: qcom: nsscc-qca8k: keep AHB clocks enabled

The QCA8084 clock controller is registered before the PHY package claims
its clocks. Unused-clock cleanup tries to gate its AHB, CNOC AHB and MDIO
AHB infrastructure, but the branches keep reporting that they are on.

Keep these three infrastructure clocks enabled throughout the controller's
lifetime, including the interval before the PHY package is initialized.

--- a/drivers/clk/qcom/nsscc-qca8k.c
+++ b/drivers/clk/qcom/nsscc-qca8k.c
@@ -1591,7 +1591,7 @@ static struct clk_branch nss_cc_ahb_clk
 				&nss_cc_ahb_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_IS_CRITICAL,
 			.ops = &clk_branch2_prepare_ops,
 		},
 	},
@@ -1663,7 +1663,7 @@ static struct clk_branch nss_cc_cnoc_ahb
 				&nss_cc_ahb_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_IS_CRITICAL,
 			.ops = &clk_branch2_prepare_ops,
 		},
 	},
@@ -1681,7 +1681,7 @@ static struct clk_branch nss_cc_mdio_ahb
 				&nss_cc_ahb_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_IS_CRITICAL,
 			.ops = &clk_branch2_prepare_ops,
 		},
 	},
