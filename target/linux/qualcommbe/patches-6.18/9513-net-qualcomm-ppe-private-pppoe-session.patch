-static bool ppe_ppp_active(void)
+/* RCU protects the kernel's standard PPP -> PPPoE -> Ethernet path walk.
+ * No opaque flow cookie is dereferenced and no PPP private data is used.
+ * Restrict the initial implementation to one untagged, unbridged WAN,
+ * one active PPP interface and one local IPv4 address. Ambiguity falls back.
+ */
+static void ppe_ppp_snapshot(struct ppe_offload *o,
+			     struct ppe_pppoe_session *session)
 {
-	struct net_device *dev;
-	bool active = false;
+	struct net_device_path_stack stack;
+	struct net_device *dev, *ppp = NULL;
+	const struct net_device *lower;
+	struct in_device *in_dev;
+	struct in_ifaddr *ifa;
+	u8 daddr[ETH_ALEN] = {};
+	int port;
 
+	memset(session, 0, sizeof(*session));
 	rcu_read_lock();
 	for_each_netdev_rcu(&init_net, dev) {
-		if (dev->type == ARPHRD_PPP && netif_running(dev)) {
-			active = true;
-			break;
-		}
-	}
+		if (dev->type != ARPHRD_PPP || !netif_running(dev))
+			continue;
+		session->active = true;
+		if (ppp)
+			goto out;
+		ppp = dev;
+	}
+	if (!ppp || dev_fill_forward_path(ppp, daddr, &stack) ||
+	    stack.num_paths != 2 || stack.path[0].type != DEV_PATH_PPPOE ||
+	    stack.path[1].type != DEV_PATH_ETHERNET ||
+	    !stack.path[0].encap.id ||
+	    stack.path[0].encap.proto != htons(ETH_P_PPP_SES) ||
+	    !is_valid_ether_addr(stack.path[0].encap.h_dest))
+		goto out;
+	lower = stack.path[1].dev;
+	port = ppe_o_port_index(o, lower);
+	if (port < 0 || !netif_running(lower) || !netif_carrier_ok(lower) ||
+	    o->ports[port].bridge || o->ports[port].unsupported ||
+	    netdev_has_any_upper_dev(o->ports[port].dev) ||
+	    !is_valid_ether_addr(lower->dev_addr))
+		goto out;
+	/* No concurrent ordinary IPv4 service on the dedicated PPPoE port. */
+	in_dev = __in_dev_get_rcu(lower);
+	if (in_dev && rcu_access_pointer(in_dev->ifa_list))
+		goto out;
+	in_dev = __in_dev_get_rcu(ppp);
+	if (!in_dev)
+		goto out;
+	ifa = rcu_dereference(in_dev->ifa_list);
+	if (!ifa || !ifa->ifa_local || rcu_access_pointer(ifa->ifa_next) ||
+	    ppp->mtu < 68 || ppp->mtu > lower->mtu - PPPOE_SES_HLEN)
+		goto out;
+	session->ifindex = ppp->ifindex;
+	session->mtu = ppp->mtu;
+	session->address = ifa->ifa_local;
+	session->sid = stack.path[0].encap.id;
+	session->port = port;
+	ether_addr_copy(session->local, lower->dev_addr);
+	ether_addr_copy(session->peer, stack.path[0].encap.h_dest);
+	session->valid = true;
+out:
 	rcu_read_unlock();
-	return active;
+}
+
+static void ppe_ppp_refresh(struct ppe_offload *o)
+{
+	struct ppe_pppoe_session session = {};
+	struct ppe_flow *f, *tmp;
+
+	lockdep_assert_held(&o->lock);
+	ppe_ppp_snapshot(o, &session);
+	if (!memcmp(&session, &o->ppp, sizeof(session)))
+		return;
+	/* Flush under the same lock before publishing any replacement session. */
+	list_for_each_entry_safe(f, tmp, &o->flow_list, list)
+		ppe_flow_remove(o, f);
+	memcpy(&o->ppp, &session, sizeof(session));
+	o->ppp_changes++;
+}
+
+static void ppe_ppp_work(struct work_struct *work)
+{
+	struct ppe_offload *o = container_of(to_delayed_work(work),
+					  struct ppe_offload, ppp_work);
+
+	mutex_lock(&o->lock);
+	if (!o->stopping) {
+		/* Channel detach can precede pppd's NETDEV_DOWN notification. */
+		ppe_ppp_refresh(o);
+		schedule_delayed_work(&o->ppp_work, msecs_to_jiffies(250));
+	}
+	mutex_unlock(&o->lock);
+}
+
+static int ppe_ppp_rule(struct ppe_offload *o, struct ppe_rule *r)
+{
+	const struct ppe_pppoe_session *s = &o->ppp;
+
+	r->out_mtu = o->ports[r->out_port].dev->mtu;
+	if (!s->active)
+		return r->out_sid ? -EOPNOTSUPP : 0;
+	if (!s->valid)
+		return -EOPNOTSUPP;
+	if (r->out_port == s->port) {
+		/* Kernel action proves PPP encapsulation in this direction. */
+		if (r->out_sid != s->sid || r->new_src != s->address ||
+		    !ether_addr_equal(r->eth.h_source, s->local) ||
+		    !ether_addr_equal(r->eth.h_dest, s->peer))
+			return -EOPNOTSUPP;
+		r->out_mtu = s->mtu;
+	} else if (r->out_sid) {
+		return -EOPNOTSUPP;
+	}
+	if (r->in_port == s->port) {
+		/* The sole session on a dedicated WAN owns this local IPv4.
+		 * Restrict download offload to DNAT, including replies to SNAT.
+		 */
+		if (r->tuple.dst != s->address || r->new_dst == r->tuple.dst)
+			return -EOPNOTSUPP;
+		r->in_sid = s->sid;
+	}
+	return 0;
 }
 
