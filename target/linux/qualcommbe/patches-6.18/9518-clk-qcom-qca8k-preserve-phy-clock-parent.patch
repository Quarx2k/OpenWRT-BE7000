Subject: [PATCH] clk: qcom: preserve the selected QCA8084 MAC clock parent

QCA8084 selects the MAC clock parents for its PCS mode explicitly. Rate
selection must not switch to another input just because its nominal rate
also matches. In QXGMII mode MAC4 can otherwise select the unused UNIPHY0
125 MHz input for 10/100/1000 Mbps, including the link-down speed fallback,
and time out while updating both RCGs.

Honor CLK_SET_RATE_NO_REPARENT in the multi-configuration selector and set
it on the QCA8084 MAC RCGs using that selector. Reject rates unavailable
from the selected parent without a warning: divider rate searches can
legitimately probe such rates.

--- a/drivers/clk/qcom/clk-rcg2.c
+++ b/drivers/clk/qcom/clk-rcg2.c
@@ -290,13 +290,14 @@ __clk_rcg2_select_conf(struct clk_hw *hw, const struct freq_multi_tbl *f,
 	unsigned long rate_diff, best_rate_diff = ULONG_MAX;
 	const struct freq_conf *conf, *best_conf = NULL;
 	struct clk_rcg2 *rcg = to_clk_rcg2(hw);
+	bool no_reparent = clk_hw_get_flags(hw) & CLK_SET_RATE_NO_REPARENT;
 	const char *name = clk_hw_get_name(hw);
 	unsigned long parent_rate, rate;
 	struct clk_hw *p;
 	int index, i;
 
 	/* Exit early if only one config is defined */
-	if (f->num_confs == 1) {
+	if (f->num_confs == 1 && !no_reparent) {
 		best_conf = f->confs;
 		goto exit;
 	}
@@ -310,6 +311,8 @@ __clk_rcg2_select_conf(struct clk_hw *hw, const struct freq_multi_tbl *f,
 		p = clk_hw_get_parent_by_index(hw, index);
 		if (!p)
 			continue;
+		if (no_reparent && p != clk_hw_get_parent(hw))
+			continue;
 
 		parent_rate = clk_hw_get_rate(p);
 		rate = calc_rate(parent_rate, conf->n, conf->m, conf->n, conf->pre_div);
@@ -326,6 +329,9 @@ __clk_rcg2_select_conf(struct clk_hw *hw, const struct freq_multi_tbl *f,
 		}
 	}
 
+	if (!best_conf && no_reparent)
+		return ERR_PTR(-EINVAL);
+
 	/*
 	 * Very unlikely. Warn if we couldn't find a correct config
 	 * due to parent not found in every config.
--- a/drivers/clk/qcom/nsscc-qca8k.c
+++ b/drivers/clk/qcom/nsscc-qca8k.c
@@ -313,6 +313,7 @@ static struct clk_rcg2 nss_cc_mac1_tx_clk_src = {
 		.name = "nss_cc_mac1_tx_clk_src",
 		.parent_data = nss_cc_uniphy1_rx_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_rx_tx312p5m_data),
+		.flags = CLK_SET_RATE_NO_REPARENT,
 		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
@@ -569,6 +570,7 @@ static struct clk_rcg2 nss_cc_mac2_tx_clk_src = {
 		.name = "nss_cc_mac2_tx_clk_src",
 		.parent_data = nss_cc_uniphy1_rx_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_rx_tx312p5m_data),
+		.flags = CLK_SET_RATE_NO_REPARENT,
 		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
@@ -807,6 +809,7 @@ static struct clk_rcg2 nss_cc_mac3_tx_clk_src = {
 		.name = "nss_cc_mac3_tx_clk_src",
 		.parent_data = nss_cc_uniphy1_rx_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_rx_tx312p5m_data),
+		.flags = CLK_SET_RATE_NO_REPARENT,
 		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
@@ -1087,6 +1090,7 @@ static struct clk_rcg2 nss_cc_mac4_tx_clk_src = {
 		.name = "nss_cc_mac4_tx_clk_src",
 		.parent_data = nss_cc_uniphy0_rx_uniphy1_rx_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy0_rx_uniphy1_rx_tx312p5m_data),
+		.flags = CLK_SET_RATE_NO_REPARENT,
 		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
@@ -1243,6 +1247,7 @@ static struct clk_rcg2 nss_cc_mac4_rx_clk_src = {
 		.name = "nss_cc_mac4_rx_clk_src",
 		.parent_data = nss_cc_uniphy0_tx_uniphy1_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy0_tx_uniphy1_tx312p5m_data),
+		.flags = CLK_SET_RATE_NO_REPARENT,
 		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
