Subject: [PATCH] net: ethernet: qualcomm: add APPE wired bridge and flowtable offload

Add optional IPQ9574 known-unicast switching and IPv4 TCP/UDP routing,
NAT and untagged PPPoE offload to the native PPE driver. Use the APPE
table layout and keep unsupported paths in software.

Flow-table operations and resource handling are adapted from Julius
Bairaktaris' HPPE driver (20862f96324f7080d1e1ff1b946b18dcb27ed21e),
with APPE layouts checked against QSDK 12.1 SSDK.

diff --git a/drivers/net/ethernet/qualcomm/Kconfig b/drivers/net/ethernet/qualcomm/Kconfig
index b636ffa..0a03925 100644
--- a/drivers/net/ethernet/qualcomm/Kconfig
+++ b/drivers/net/ethernet/qualcomm/Kconfig
@@ -78,6 +78,15 @@ config QCOM_PPE
 	  To compile this driver as a module, choose M here. The module
 	  will be called qcom-ppe.
 
+config QCOM_PPE_OFFLOAD
+	bool "IPQ9574 PPE wired bridge and flowtable offload"
+	depends on QCOM_PPE && BRIDGE && NF_FLOW_TABLE
+	select NET_SWITCHDEV
+	help
+	  Offload known unicast bridge traffic and IPv4 TCP/UDP routing,
+	  NAT and untagged PPPoE on the physical IPQ9574 PPE ports.
+	  Unsupported traffic continues through the software network stack.
+
 source "drivers/net/ethernet/qualcomm/rmnet/Kconfig"
 
 endif # NET_VENDOR_QUALCOMM
diff --git a/drivers/net/ethernet/qualcomm/ppe/Makefile b/drivers/net/ethernet/qualcomm/ppe/Makefile
index 0ada397..000f839 100644
--- a/drivers/net/ethernet/qualcomm/ppe/Makefile
+++ b/drivers/net/ethernet/qualcomm/ppe/Makefile
@@ -5,6 +5,7 @@
 
 obj-$(CONFIG_QCOM_PPE) += qcom-ppe.o
 qcom-ppe-objs := ppe.o ppe_config.o ppe_debugfs.o ppe_port.o
+qcom-ppe-$(CONFIG_QCOM_PPE_OFFLOAD) += ppe_flow.o ppe_offload.o ppe_switchdev.o
 
 #EDMA
 qcom-ppe-objs += edma.o edma_cfg_rx.o edma_cfg_tx.o edma_debugfs.o edma_port.o edma_rx.o edma_tx.o edma_ethtool.o
diff --git a/drivers/net/ethernet/qualcomm/ppe/edma_port.c b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
index 6730cee..f3bc773 100644
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
