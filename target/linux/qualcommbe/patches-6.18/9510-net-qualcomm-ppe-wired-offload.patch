@@ -307,6 +307,26 @@ static int edma_port_set_mac_address(struct net_device *netdev, void *macaddr)
 	return 0;
 }
 
+#include <linux/platform_device.h>
+#include "ppe_offload.h"
+
+static int edma_port_parent_id(struct net_device *dev,
+			       struct netdev_phys_item_id *ppid)
+{
+	struct edma_port_priv *priv = netdev_priv(dev);
+	struct ppe_device *ppe = priv->ppe_port->ppe_dev;
+	struct resource *res;
+	u64 id;
