+	ppid->id_len = sizeof(id);
+	memcpy(ppid->id, &id, sizeof(id));
+	return 0;
+}
+
 static const struct net_device_ops edma_port_netdev_ops = {
 	.ndo_open = edma_port_open,
 	.ndo_stop = edma_port_close,
@@ -318,6 +338,8 @@ static const struct net_device_ops edma_port_netdev_ops = {
 	.ndo_eth_ioctl = edma_port_ioctl,
 	.ndo_features_check = edma_port_feature_check,
 	.ndo_select_queue = edma_port_select_queue,
+	.ndo_setup_tc = ppe_offload_setup_tc,
+	.ndo_get_port_parent_id = edma_port_parent_id,
 };
 
 /**
@@ -334,6 +356,7 @@ void edma_port_destroy(struct ppe_port *port)
 	edma_port_deconfigure(netdev);
 	edma_port_stats_free(netdev);
 	unregister_netdev(netdev);
+	ppe_offload_port_set(port->ppe_dev, port_id, NULL);
 	free_netdev(netdev);
 	ppe_port_phylink_destroy(port);
 	edma_ctx->netdev_arr[port_id - 1] = NULL;
@@ -433,6 +456,7 @@ int edma_port_setup(struct ppe_port *port)
 	}
 
 	/* Register the network interface. */
+	ppe_offload_port_set(ppe_dev, port_id, netdev);
 	ret = register_netdev(netdev);
 	if (ret) {
 		netdev_dbg(netdev, "Error registering netdevice %s\n",
@@ -444,6 +468,7 @@ int edma_port_setup(struct ppe_port *port)
 	return ret;
 
 register_netdev_fail:
+	ppe_offload_port_set(ppe_dev, port_id, NULL);
 	ppe_port_phylink_destroy(port);
 port_phylink_setup_fail:
 	edma_port_deconfigure(netdev);
