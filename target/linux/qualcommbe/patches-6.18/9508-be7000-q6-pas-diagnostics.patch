Subject: [PATCH] firmware: qcom: trace BE7000 Q6 PAS startup

Trace the PAS6 clock, bandwidth, SCM mutex and secure-call boundaries.
Limit messages to xiaomi,be7000 with the external WLAN stack selected.
Report only the first interrupted SMC before the resume loop completes.

--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -706,6 +706,8 @@
 int qcom_scm_pas_auth_and_reset(u32 peripheral)
 {
 	int ret;
+	bool trace = IS_ENABLED(CONFIG_QCOM_BE7000_WLAN) && peripheral == 6 &&
+		     of_machine_is_compatible("xiaomi,be7000");
 	struct qcom_scm_desc desc = {
 		.svc = QCOM_SCM_SVC_PIL,
 		.cmd = QCOM_SCM_PIL_PAS_AUTH_AND_RESET,
@@ -715,19 +717,35 @@
 	};
 	struct qcom_scm_res res;
 
+	if (trace)
+		pr_info("BE7000 PAS6 clocks begin core=%d iface=%d bus=%d path=%d\n",
+			!!__scm->core_clk, !!__scm->iface_clk,
+			!!__scm->bus_clk, !!__scm->path);
 	ret = qcom_scm_clk_enable();
+	if (trace)
+		pr_info("BE7000 PAS6 clocks end ret=%d; bandwidth begin\n", ret);
 	if (ret)
 		return ret;
 
 	ret = qcom_scm_bw_enable();
+	if (trace)
+		pr_info("BE7000 PAS6 bandwidth end ret=%d\n", ret);
 	if (ret)
 		goto disable_clk;
 
+	if (trace)
+		pr_info("BE7000 PAS6 SCM call begin\n");
 	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (trace)
+		pr_info("BE7000 PAS6 SCM call end ret=%d; bandwidth release begin\n", ret);
 	qcom_scm_bw_disable();
 
 disable_clk:
+	if (trace)
+		pr_info("BE7000 PAS6 clocks release begin\n");
 	qcom_scm_clk_disable();
+	if (trace)
+		pr_info("BE7000 PAS6 clocks release end\n");
 
 	return ret ? : res.result[0];
 }
--- a/drivers/firmware/qcom/qcom_scm-smc.c
+++ b/drivers/firmware/qcom/qcom_scm-smc.c
@@ -7,6 +7,8 @@
 #include <linux/errno.h>
 #include <linux/delay.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/sched.h>
 #include <linux/slab.h>
 #include <linux/types.h>
 #include <linux/firmware/qcom/qcom_scm.h>
@@ -35,23 +37,45 @@
 #define SCM_SMC_FIRST_REG_IDX	2
 #define SCM_SMC_LAST_REG_IDX	(SCM_SMC_FIRST_REG_IDX + SCM_SMC_N_REG_ARGS - 1)
 
+static bool be7000_pas_trace(const struct arm_smccc_args *smc)
+{
+	return IS_ENABLED(CONFIG_QCOM_BE7000_WLAN) &&
+		ARM_SMCCC_OWNER_NUM(smc->args[0]) == ARM_SMCCC_OWNER_SIP &&
+		ARM_SMCCC_FUNC_NUM(smc->args[0]) ==
+			SCM_SMC_FNID(QCOM_SCM_SVC_PIL, QCOM_SCM_PIL_PAS_AUTH_AND_RESET) &&
+		smc->args[2] == 6 && of_machine_is_compatible("xiaomi,be7000");
+}
+
 static void __scm_smc_do_quirk(const struct arm_smccc_args *smc,
 			       struct arm_smccc_res *res)
 {
 	unsigned long a0 = smc->args[0];
 	struct arm_smccc_quirk quirk = { .id = ARM_SMCCC_QUIRK_QCOM_A6 };
+	bool trace = be7000_pas_trace(smc);
+	unsigned int interrupted = 0;
 
 	quirk.state.a6 = 0;
 
+	if (trace)
+		pr_info("BE7000 PAS6 cpu=%u pid=%d SMC enter fn=%lx arginfo=%lx pas=%lu\n",
+			raw_smp_processor_id(), task_pid_nr(current),
+			a0, smc->args[1], smc->args[2]);
 	do {
 		arm_smccc_smc_quirk(a0, smc->args[1], smc->args[2],
 				    smc->args[3], smc->args[4], smc->args[5],
 				    quirk.state.a6, smc->args[7], res, &quirk);
 
-		if (res->a0 == QCOM_SCM_INTERRUPTED)
+		if (res->a0 == QCOM_SCM_INTERRUPTED) {
+			if (trace && !interrupted++)
+				pr_info("BE7000 PAS6 SMC interrupted; resume a6=%lx\n",
+					quirk.state.a6);
 			a0 = res->a0;
+		}
 
 	} while (res->a0 == QCOM_SCM_INTERRUPTED);
+	if (trace)
+		pr_info("BE7000 PAS6 SMC return a0=%lx a1=%lx interrupted=%u\n",
+			res->a0, res->a1, interrupted);
 }
 
 static void fill_wq_resume_args(struct arm_smccc_args *resume, u32 smc_call_ctx)
@@ -97,6 +121,7 @@
 	u32 wq_ctx, smc_call_ctx;
 	struct arm_smccc_args resume;
 	struct arm_smccc_args *smc = waitq;
+	bool trace = be7000_pas_trace(waitq);
 
 	do {
 		__scm_smc_do_quirk(smc, res);
@@ -105,7 +130,12 @@
 			wq_ctx = res->a1;
 			smc_call_ctx = res->a2;
 
+			if (trace)
+				pr_info("BE7000 PAS6 WAITQ begin ctx=%u call=%u\n",
+					wq_ctx, smc_call_ctx);
 			ret = qcom_scm_wait_for_wq_completion(wq_ctx);
+			if (trace)
+				pr_info("BE7000 PAS6 WAITQ end ret=%d\n", ret);
 			if (ret)
 				return ret;
 
@@ -121,6 +151,7 @@
 			struct arm_smccc_res *res, bool atomic)
 {
 	int ret, retry_count = 0;
+	bool trace = be7000_pas_trace(smc);
 
 	if (atomic) {
 		__scm_smc_do_quirk(smc, res);
@@ -128,11 +159,18 @@
 	}
 
 	do {
+		if (trace)
+			pr_info("BE7000 PAS6 cpu=%u pid=%d SCM mutex begin retry=%d\n",
+				raw_smp_processor_id(), task_pid_nr(current), retry_count);
 		mutex_lock(&qcom_scm_lock);
+		if (trace)
+			pr_info("BE7000 PAS6 SCM mutex acquired\n");
 
 		ret = __scm_smc_do_quirk_handle_waitq(dev, smc, res);
 
 		mutex_unlock(&qcom_scm_lock);
+		if (trace)
+			pr_info("BE7000 PAS6 SCM mutex released ret=%d\n", ret);
 
 		if (ret)
 			return ret;
