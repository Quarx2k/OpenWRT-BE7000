/* Native PPE/QCA8084 Ethernet and ath12k PCIe WLAN with BE7000 USB boot. */
/dts-v1/;

#include "ipq9574-be7000.dtsi"

/* Use the native PCIe/PHY bindings for the QCN9224 5 GHz radio.
 * IPQ9574 integrated WLAN and BE7000 ath12k board/calibration data still
 * need bring-up; no CNSS/WCSS platform nodes are enabled in this profile.
 */
&pcie2 {
	pinctrl-0 = <&be7000_pcie2_pins>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie2_phy {
	status = "okay";
};

&tlmm {
	be7000_pcie2_pins: pcie2-state {
		clkreq-pins {
			pins = "gpio28";
			function = "pcie2_clk";
			drive-strength = <6>;
			bias-pull-up;
		};
		reset-pins {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};
	};
};

#include "ipq9574-be7000-ethernet.dtsi"
