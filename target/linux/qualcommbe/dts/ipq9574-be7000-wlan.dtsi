/* BE7000 stock WLAN memory pools and radio configuration. */
/ {
	reserved-memory {
		mhi_region2: mhi-pool2 {
			compatible = "shared-dma-pool";
			no-map;
			size = <0 0xf00000>;
			alignment = <0 0x1000>;
		};
		mhi_region3: mhi-pool3 {
			compatible = "shared-dma-pool";
			no-map;
			size = <0 0xf00000>;
			alignment = <0 0x1000>;
		};
	};
};

&pcie2_phy { status = "okay"; };
/* PCIe3 is disabled in this board's QFPROM fuses. */
&pcie3_phy { status = "disabled"; };
&pcie2_x2 {
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";
	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		wifi@0 {
			reg = <0 0 0 0 0>;
			qrtr_node_id = <0x32>;
			memory-region = <&qcn9224_pcie2>, <&mhi_region2>;
			memory-region-names = "host-ddr-mem", "mhi-region";
			boot-args = <2 4 0x34 3 0 0 4 4 0x18 3 0 0 0 4 0 0 0 0>;
		};
	};
};
&pcie3_x2 {
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "disabled";
	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		wifi@0 {
			reg = <0 0 0 0 0>;
			qrtr_node_id = <0x33>;
			memory-region = <&qcn9224_pcie3>, <&mhi_region3>;
			memory-region-names = "host-ddr-mem", "mhi-region";
			boot-args = <2 4 0x34 3 0 0 4 4 0x18 3 0 0 0 4 0 0 0 0>;
		};
	};
};

&wifi0 { status = "okay"; };
&wifi6 {
	qrtr_node_id = <0x32>;
	base-addr = <0x54100000>;
	hremote-size = <0x1c00000>;
	m3-dump-addr = <0x55d00000>;
	etr-addr = <0x55e00000>;
	caldb-addr = <0x55f00000>;
	caldb-size = <0x800000>;
	pageable-addr = <0x56700000>;
	pageable-size = <0xc00000>;
	tgt-mem-mode = <0>;
	hremote_node = <&qcn9224_pcie2>;
	board_id = <4>;
	status = "okay";
};
&wifi7 {
	qrtr_node_id = <0x33>;
	base-addr = <0x57300000>;
	hremote-size = <0x1c00000>;
	m3-dump-addr = <0x58f00000>;
	etr-addr = <0x59000000>;
	caldb-addr = <0x59100000>;
	caldb-size = <0x800000>;
	pageable-addr = <0x59900000>;
	pageable-size = <0xc00000>;
	tgt-mem-mode = <0>;
	hremote_node = <&qcn9224_pcie3>;
	board_id = <2>;
	status = "disabled";
};
