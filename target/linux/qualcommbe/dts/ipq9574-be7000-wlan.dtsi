		wifi7: wifi7@f00000 {
			compatible  = "qcom,cnss-qcn9224";
			qcom,wlan-ramdump-dynamic = <0x600000>;
			qca,auto-restart;
			interrupt-bmap = <0x100512>;
			node_id = <3>;
#ifdef __IPQ_MEM_PROFILE_512_MB__
			/* qcn9224 tgt-mem-mode=1 layout - 27MB
			 * +=========+==============+=========+
			 * |  Region | Start Offset |   Size  |
			 * +---------+--------------+---------+
			 * | HREMOTE |  0x52000000  |   13MB  |
			 * +---------+--------------+---------+
			 * |  Caldb  |  0x52D00000  |   8MB   |
			 * +---------+--------------+---------+
			 * | M3 Dump |  0x53500000  |   1MB   |
			 * +---------+--------------+---------+
			 * |   ETR   |  0x53600000  |   1MB   |
			 * +---------+--------------+---------+
			 * |Pageable |  0x53700000  |   4MB   |
			 * +==================================+
			 */
			base-addr = <0x52000000>;
			caldb-addr = <0x52D00000>;
			m3-dump-addr = <0x53500000>;
			etr-addr = <0x53600000>;
			pageable-addr = <0x53700000>;
			hremote-size = <0xD00000>;
			pageable-size = <0x400000>;
			tgt-mem-mode = <0x1>;
#else
			/* qcn9224 tgt-mem-mode=0 layout - 36MB
			 * +=========+==============+=========+
			 * |  Region | Start Offset |   Size  |
			 * +---------+--------------+---------+
			 * | HREMOTE |  0x54900000  |   17MB  |
			 * +---------+--------------+---------+
			 * |  Caldb  |  0x55A00000  |   8MB   |
			 * +---------+--------------+---------+
			 * | M3 Dump |  0x56200000  |   1MB   |
			 * +---------+--------------+---------+
			 * |   ETR   |  0x56300000  |   1MB   |
			 * +---------+--------------+---------+
			 * |Pageable |  0x56400000  |   9MB   |
			 * +==================================+
			 */
			base-addr = <0x54900000>;
			caldb-addr = <0x55A00000>;
			m3-dump-addr = <0x56200000>;
			etr-addr = <0x56300000>;
			pageable-addr = <0x56400000>;
			hremote-size = <0x1100000>;
			pageable-size = <0x900000>;
			tgt-mem-mode = <0x0>;
#endif
			caldb-size = <0x800000>;
			qca,extended-intc;
			early_cal = <&pcie3_x2>;
			interrupts-extended =
				<&qcn9224_in3 5 0>,
				<&qcn9224_in3 6 0>,
