CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_xiaomi_be7000-nand=y
CONFIG_ALL_KMODS=y
CONFIG_DEVEL=y
CONFIG_BUILDBOT=y
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
# CONFIG_IB is not set
# CONFIG_SDK is not set
# CONFIG_MAKE_TOOLCHAIN is not set
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-be7000-wifi=y
CONFIG_PACKAGE_be7000-ath-board=y
CONFIG_PACKAGE_be7000-package-feed=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_SQUASHFS_XZ=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_IMAGES_GZIP is not set
# CONFIG_SIGN_EACH_PACKAGE is not set
# CONFIG_SIGN_FIRMWARE is not set
